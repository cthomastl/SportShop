# Copy this file to .env and fill in your values.
# The .env file is gitignored and will never be committed.

# ── Local development (docker-compose.yml) ───────────────────────────────────
# These are used to create the local postgres container and connect to it.
DB_USER=sportshop
DB_PASSWORD=sportshop

# ── Production (docker-compose.prod.yml) ─────────────────────────────────────
# Uncomment and fill in when pointing at your production database (e.g. AWS RDS).
# DB_URL=jdbc:postgresql://<your-rds-host>:5432/sportshop?sslmode=require
# DB_USER=<your-db-user>
# DB_PASSWORD=<your-db-password>

# ── CI/CD ─────────────────────────────────────────────────────────────────────
# Container registry prefix used by docker-compose.prod.yml
# REGISTRY=ghcr.io/your-github-username
# IMAGE_TAG=latest
